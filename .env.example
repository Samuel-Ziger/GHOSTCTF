# Copiar para .env e preencher (nunca commitar .env)

# ── Postgres direto (Supabase: Settings → Database → URI ou Session Pooler para IPv4)
# A password na URL tem de estar codificada se tiver @, #, etc. (encodeURIComponent)
# Exemplo: postgresql://postgres:SENHA_ENCODADA@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=

# ── Alternativa: API Supabase (sem DATABASE_URL)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

PORT=3847

# Cookie de sessão CTF (opcional): enviado em todos os curl HTTP/HTTPS do pipeline (`-b` curl).
# Útil para re-correr o recon pós-login e o detector de flags apanhar corpos só autenticados.
# GHOSTCTF_HTTP_COOKIE="PHPSESSID=abc123; session=xyz"

# VirusTotal — subdomínios (módulo `virustotal` na UI)
# VIRUSTOTAL_API_KEY=

# Webhook após recon gravado e após relatório IA (Discord: resumo + embeds; outro URL: JSON)
# GHOSTCTF_WEBHOOK_URL=https://discord.com/api/webhooks/...
# (legacy: GHOSTRECON_WEBHOOK_URL)
#
# ── Relatórios IA (OpenRouter como na cloud do GHOSTRECON; podes copiar o bloco do .env do GHOSTRECON) ──
# Chave e modelo (obrigatório OPENROUTER_API_KEY para a cloud; fallback LM Studio / Claude se configurados)
# OPENROUTER_API_KEY=
# GHOSTCTF_OPENROUTER_MODEL=google/gemma-4-31b-it
# (equivalente GHOSTRECON: GHOSTRECON_OPENROUTER_MODEL — lido se GHOSTCTF_* vazio)
# OpenRouter pede identificação opcional do site / app (recomendado em produção)
# GHOSTCTF_OPENROUTER_HTTP_REFERER=https://tua-app.local
# GHOSTCTF_OPENROUTER_APP_TITLE=GHOSTCTF
# (equivalentes: GHOSTRECON_OPENROUTER_HTTP_REFERER, GHOSTRECON_OPENROUTER_APP_TITLE)
# Resposta JSON estruturada (1 = activo; alguns modelos falham com json_object → GHOSTCTF_OPENROUTER_JSON_OBJECT=0)
# GHOSTCTF_OPENROUTER_JSON_OBJECT=1
# Retentativas OpenRouter para 429/5xx/timeout
# GHOSTCTF_OPENROUTER_MAX_RETRIES=4
# Espera entre retentativas Gemini (só se GHOSTCTF_AI_ALLOW_GEMINI=1; ignorado na prática sem Gemini)
# GHOSTCTF_AI_FALLBACK_WAIT_SEC=60
# Claude (Anthropic) se ainda não houver relatório após OpenRouter + LM Studio
# ANTHROPIC_API_KEY=
# GHOSTCTF_CLAUDE_MODEL=claude-3-5-sonnet-20241022
# (legacy: GHOSTRECON_CLAUDE_MODEL)
# LM Studio local (OpenAI-compatible) — mesmo bloco que no GHOSTRECON
# GHOSTRECON_LMSTUDIO_ENABLED=1
# GHOSTRECON_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# GHOSTRECON_LMSTUDIO_MODEL=qwen2.5-7b-instruct
# GHOSTRECON_LMSTUDIO_API_KEY=lm-studio
# GHOSTRECON_LMSTUDIO_N_CTX=4096
# GHOSTRECON_LMSTUDIO_MAX_OUTPUT_TOKENS=1024
# GHOSTRECON_LMSTUDIO_TIMEOUT_MS=900000
# GHOSTRECON_LMSTUDIO_TEMPERATURE=0.25
# GHOSTRECON_LMSTUDIO_MAX_INPUT_CHARS=14000
# GHOSTRECON_LMSTUDIO_CHARS_PER_TOKEN=1.45
# GHOSTCTF_AI_AUTO=0     # 1 ou omitido = permite IA após recon (com confirmação na UI); 0 = desliga no servidor
# (legacy: GHOSTRECON_AI_AUTO)
# Limite de caracteres por campo no relatório IA (GHOSTCTF_* ou GHOSTRECON_AI_*)
# GHOSTCTF_AI_RELATORIO_MAX_CHARS=2400
# GHOSTCTF_AI_PROXIMOS_MAX_CHARS=1600
# Política GHOSTCTF: sem Gemini por defeito. Para cascata com Gemini (como GHOSTRECON): GHOSTCTF_AI_ALLOW_GEMINI=1
# GHOSTCTF_AI_ALLOW_GEMINI=1

# Rate limit POST /api/recon/stream (0 = desligado)
# GHOSTCTF_RL_MAX=12
# GHOSTCTF_RL_WINDOW_MS=60000
# (legacy: GHOSTRECON_RL_*)

# Common Crawl — URL completa do CDX API (opcional; senão usa collinfo)
# GHOSTCTF_CC_CDX_API=https://index.commoncrawl.org/CC-MAIN-2025-51-index
# (legacy: GHOSTRECON_CC_CDX_API)

# SQLite local (só se não usares Supabase)
# GHOSTCTF_DB=
# (legacy: GHOSTRECON_DB)

# ── Kali mode / wpscan (WordPress enumeration) ──
# Se o passivo detectar WordPress, o Kali mode pode rodar wpscan (apenas enumeração).
# GHOSTCTF_WPSCAN_DETECTION_MODE=mixed
# GHOSTCTF_WPSCAN_TIMEOUT_MS=240000
# (legacy: GHOSTRECON_WPSCAN_*)
